{
  "name": "cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/cli",
  "tags": ["type:app", "lang:go"],
  "namedInputs": {
    "go": ["{projectRoot}/**/*.go", "{projectRoot}/go.mod", "{projectRoot}/go.sum", "{projectRoot}/tui/banyan.txt"]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["web:build"],
      "inputs": ["go", "{workspaceRoot}/apps/web/dist/**/*"],
      "outputs": ["{workspaceRoot}/dist/apps/cli"],
      "options": {
        "cwd": "apps/cli",
        "commands": [
          {
            "command": "./build.sh --output ../../dist/apps/cli",
            "forwardAllArgs": false,
            "description": "Build for Unix (Linux/macOS)"
          }
        ]
      },
      "configurations": {
        "windows": {
          "commands": [
            {
              "command": "powershell -ExecutionPolicy Bypass -File build.ps1 -OutputDir ../../dist/apps/cli",
              "forwardAllArgs": false,
              "description": "Build for Windows"
            }
          ]
        },
        "production": {
          "commands": [
            {
              "command": "./build.sh --output ../../dist/apps/cli --clean",
              "forwardAllArgs": false,
              "description": "Production build for Unix (Linux/macOS)"
            }
          ]
        },
        "production-windows": {
          "commands": [
            {
              "command": "powershell -ExecutionPolicy Bypass -File build.ps1 -OutputDir ../../dist/apps/cli -Clean",
              "forwardAllArgs": false,
              "description": "Production build for Windows"
            }
          ]
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["go"],
      "options": {
        "cwd": "apps/cli",
        "command": "go test ./..."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["go"],
      "options": {
        "cwd": "apps/cli",
        "command": "go vet ./..."
      }
    },
    "fmt": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/cli",
        "command": "go fmt ./..."
      }
    },
    "tidy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/cli",
        "command": "go mod tidy"
      }
    }
  }
}

