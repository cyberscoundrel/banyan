{
  "name": "node",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/node",
  "tags": ["type:app", "lang:go"],
  "namedInputs": {
    "go": ["{projectRoot}/**/*.go", "{projectRoot}/go.mod", "{projectRoot}/go.sum"]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["go", { "env": "NX_BUILD_PLATFORM" }],
      "outputs": ["{workspaceRoot}/dist/apps/node"],
      "options": {
        "cwd": "apps/node",
        "command": "./build.sh --output ../../dist/apps/node"
      },
      "configurations": {
        "windows": {
          "command": "powershell -ExecutionPolicy Bypass -File build.ps1 -OutputDir ../../dist/apps/node"
        },
        "production": {
          "command": "./build.sh --output ../../dist/apps/node --clean"
        },
        "production-windows": {
          "command": "powershell -ExecutionPolicy Bypass -File build.ps1 -OutputDir ../../dist/apps/node -Clean"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["go"],
      "options": {
        "cwd": "apps/node",
        "command": "go test ./..."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["go"],
      "options": {
        "cwd": "apps/node",
        "command": "go vet ./..."
      }
    },
    "fmt": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/node",
        "command": "go fmt ./..."
      }
    },
    "tidy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/node",
        "command": "go mod tidy"
      }
    }
  }
}

