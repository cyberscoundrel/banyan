# Standalone Dockerfile - Clones the repo and builds the web app
# Use this when you don't have the repository cloned locally
#
# Build:   docker build -t banyan-web -f Dockerfile.standalone \
#            --build-arg REPO_URL=https://github.com/YOUR_ORG/banyan-web-docs.git .
# Run:     docker run -p 8080:80 banyan-web
#
# Optional build args:
#   REPO_URL    - Git repository URL (required)
#   BRANCH      - Branch to checkout (default: main)

# Stage 1: Clone and build
FROM node:20-alpine AS builder

# Install git
RUN apk add --no-cache git

# Build arguments
ARG REPO_URL
ARG BRANCH=main

# Validate REPO_URL is provided
RUN if [ -z "$REPO_URL" ]; then \
      echo "Error: REPO_URL build argument is required"; \
      echo "Usage: docker build --build-arg REPO_URL=https://github.com/YOUR_ORG/repo.git ..."; \
      exit 1; \
    fi

WORKDIR /app

# Clone the repository
RUN git clone --depth 1 --branch ${BRANCH} ${REPO_URL} .

# Install root dependencies
RUN npm ci --ignore-scripts

# Install web app dependencies and build
WORKDIR /app/apps/web
RUN npm ci
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine AS production

# Copy custom nginx config for SPA routing
RUN rm /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
