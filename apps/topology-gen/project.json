{
  "name": "topology-gen",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/topology-gen",
  "tags": ["type:app", "lang:go"],
  "namedInputs": {
    "go": ["{projectRoot}/**/*.go", "{projectRoot}/go.mod", "{projectRoot}/go.sum"]
  },
  "implicitDependencies": ["node"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["go"],
      "outputs": ["{workspaceRoot}/dist/apps/topology-gen"],
      "options": {
        "cwd": "apps/topology-gen",
        "command": "go build -o ../../dist/apps/topology-gen/generator.exe generator.go"
      },
      "configurations": {
        "production": {
          "command": "go build -ldflags=\"-s -w\" -o ../../dist/apps/topology-gen/generator.exe generator.go"
        }
      }
    },
    "create-topology": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "node:build"],
      "inputs": ["{projectRoot}/**/*.json", "!{projectRoot}/project.json"],
      "outputs": ["{workspaceRoot}/dist/topology/{args.name}"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "powershell -Command \"& .\\dist\\apps\\topology-gen\\generator.exe apps\\topology-gen\\{args.config} dist\\topology\\{args.name} --banyan-path=../../../../apps/node\""
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["go"],
      "options": {
        "cwd": "apps/topology-gen",
        "command": "go test ./..."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["go"],
      "options": {
        "cwd": "apps/topology-gen",
        "command": "go vet ./..."
      }
    },
    "tidy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/topology-gen",
        "command": "go mod tidy"
      }
    }
  }
}

